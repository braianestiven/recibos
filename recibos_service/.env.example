# Variables de recibos_service (L33). Copie este archivo como .env y llene los valores solo en su máquina.
# El archivo .env no se sube al repositorio. Este ejemplo no lleva valores: los valores por defecto y los
# rangos están en el README y en conf/conf.py.

# Generales
RECIBOS_SERVICE_ENV=
RECIBOS_SERVICE_PORT=
RECIBOS_SERVICE_ROL_AUTORIZADO=
RECIBOS_SERVICE_CORS_ORIGENES=
RECIBOS_SERVICE_PROXIES_CONFIANZA=
RECIBOS_SERVICE_WORKERS=
RECIBOS_SERVICE_HILOS=

# Límites del lote (se pueden bajar, no subir)
RECIBOS_SERVICE_LIMITE_LOTE_S=
RECIBOS_SERVICE_MAX_FILAS=
RECIBOS_SERVICE_MAX_ARCHIVO_BYTES=
RECIBOS_SERVICE_CORTE_MYSQL=

# Servicios
RECIBOS_SERVICE_USERINFO_URL=
RECIBOS_SERVICE_PARAMETROS_URL=
RECIBOS_SERVICE_PARAMETROS_REGLAS=
RECIBOS_SERVICE_S3_BUCKET=
RECIBOS_SERVICE_SSM_RUTA=

# Oracle académico (solo lectura, TCPS)
RECIBOS_SERVICE_ORACLE_HOST=
RECIBOS_SERVICE_ORACLE_PUERTO=
RECIBOS_SERVICE_ORACLE_SERVICIO=
RECIBOS_SERVICE_ORACLE_CA=

# MySQL de weboffice (TLS)
RECIBOS_SERVICE_MYSQL_HOST=
RECIBOS_SERVICE_MYSQL_PUERTO=
RECIBOS_SERVICE_MYSQL_BASE=
RECIBOS_SERVICE_MYSQL_CA=
RECIBOS_SERVICE_MYSQL_PREFIJO=
RECIBOS_SERVICE_MYSQL_LLAVE_LOTE=
RECIBOS_SERVICE_MYSQL_MAX_NOMBRE_ARCHIVO=

# Tabla de festivos de weboffice (D5)
RECIBOS_SERVICE_FESTIVOS_MOTOR=
RECIBOS_SERVICE_FESTIVOS_TABLA=
RECIBOS_SERVICE_FESTIVOS_COLUMNAS=

# Solo con RECIBOS_SERVICE_ENV=dev: credenciales locales en lugar de SSM. Nunca en test ni en producción.
RECIBOS_SERVICE_ORACLE_USUARIO=
RECIBOS_SERVICE_ORACLE_CLAVE=
RECIBOS_SERVICE_MYSQL_USUARIO=
RECIBOS_SERVICE_MYSQL_CLAVE=

# Región de AWS para S3 y SSM (en ECS la pone la tarea)
AWS_REGION=
